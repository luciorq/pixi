{#- Cache dirs: keep zig's caches inside the work directory so builds stay
    hermetic and incremental rebuilds reuse them. Exported unconditionally
    because the conda-forge zig activation pre-sets a HOME-based
    ZIG_GLOBAL_CACHE_DIR; only an explicit value in the backend's `env`
    config suppresses the export (the generator checks the config keys).
    C toolchain: route everything the build spawns (configure/make steps,
    dependency build scripts probing $CC) through zig's C toolchain,
    targeting the same triple as the zig build itself. CC_FOR_BUILD stays
    untargeted so tools compiled to run on the build machine during cross
    builds keep working. -#}
{%- macro env(key) -%}
{%- if is_bash %}{{ "$" ~ key }}{% else %}{{ "%" ~ key ~ "%" }}{% endif -%}
{%- endmacro -%}
{%- macro export(key, value) -%}
{%- if is_bash -%}
export {{ key }}="{{ value }}"
{%- else -%}
SET "{{ key }}={{ value }}"
{%- endif -%}
{%- endmacro -%}
{#- The install prefix follows the TARGET platform: Windows packages use the
    Library\ subdirectory of the prefix regardless of which machine builds
    them (relevant when cross-compiling for Windows from unix). -#}
{%- if host_is_windows -%}
{%- set install_prefix = env("PREFIX") ~ "/Library" if is_bash else env("LIBRARY_PREFIX") -%}
{%- else -%}
{%- set install_prefix = env("PREFIX") -%}
{%- endif -%}
{%- if export_global_cache %}
{{ export("ZIG_GLOBAL_CACHE_DIR", env("SRC_DIR") ~ ("/" if is_bash else "\\") ~ ".zig-global-cache") }}
{%- endif %}
{%- if export_local_cache %}
{{ export("ZIG_LOCAL_CACHE_DIR", env("SRC_DIR") ~ ("/" if is_bash else "\\") ~ ".zig-local-cache") }}
{%- endif %}
{% if cc_flags is not none %}
{{ export("CC", "zig cc" ~ cc_flags) }}
{{ export("CXX", "zig c++" ~ cc_flags) }}
{{ export("AR", "zig ar") }}
{{ export("RANLIB", "zig ranlib") }}
{{ export("CC_FOR_BUILD", "zig cc") }}
{{ export("CXX_FOR_BUILD", "zig c++") }}
{% endif %}
{% if is_bash -%}
mkdir -p "{{ install_prefix }}"
{%- else -%}
if not exist "{{ install_prefix }}" mkdir "{{ install_prefix }}"
{%- endif %}
zig build --build-file "{{ source_dir }}{{ "/" if is_bash else "\\" }}build.zig" --prefix "{{ install_prefix }}" --search-prefix "{{ install_prefix }}"{% for arg in args %} {{ arg }}{% endfor %}
{%- if not is_bash %}
if errorlevel 1 exit 1
{%- endif %}
